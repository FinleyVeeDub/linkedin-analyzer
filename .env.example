# LinkedIn Analyzer Configuration
# Copy this file to .env and adjust as needed

# Server Settings
HOST=127.0.0.1
PORT=8000

# LinkedIn Settings
LINKEDIN_URL=https://www.linkedin.com
LINKEDIN_LOGIN_URL=https://www.linkedin.com/login

# Session Storage (absolute path recommended)
SESSION_DIR=./browser_sessions

# Session Encryption
# Optional explicit key (recommended for shared environments)
# SESSION_ENCRYPTION_KEY=your-long-random-secret
# Key file used when SESSION_ENCRYPTION_KEY is not set
SESSION_ENCRYPTION_KEY_FILE=~/.linkedin-analyzer/session.key

# Browser Settings
# Set to True for automated runs without UI
BROWSER_HEADLESS=False
# Timeout in milliseconds
BROWSER_TIMEOUT=60000

# MCP Settings
MCP_SERVER_NAME=linkedin-analyzer
